{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run sync:cloud-ui && vite build",
    "build:cloud-ui": "npm run sync:cloud-ui && tailwindcss -i web/client/styles.css -o dist/web/client/styles.css --minify && node web/buildClient.mjs",
    "start": "node server.ts",
    "test": "node --test src/format.test.ts src/engine/rehearsalCore.test.ts src/engine/tenKMatrix.test.ts src/engine/backendSync.test.ts src/engine/spatialTelemetry.test.ts server.test.ts",
    "test:ui": "node scripts/verify-ui.mjs",
    "sync:cloud-ui": "node web/syncStudioClient.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "uplot": "^1.6.32",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
